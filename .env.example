# Copia este archivo como .env.local y completa los valores. Nunca subas .env.local.
# Los valores reales los entrega el líder por un canal privado.

# Supabase (región São Paulo). Las lee el servidor (lib/datos/oferta-remota.ts);
# no llevan el prefijo NEXT_PUBLIC_ porque el navegador no consulta Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Solo servidor. Nunca en código del navegador. La usa el registro de alertas del asistente.
SUPABASE_SERVICE_ROLE_KEY=
# Solo para cargar lotes de datos (scripts/cargar-lotes.mjs). No la necesita el sitio.
SUPABASE_DB_URL=

# Gemini, nivel pagado (ADR 0004). Solo servidor.
GEMINI_API_KEY=
# Nombre del modelo de Gemini. Se elige en la consola de Google y no se fija en el código.
GEMINI_MODELO=

# Opcional: con OFERTA_LOCAL=1 el sitio lee la oferta desde un archivo y no desde Supabase
# (CI y pruebas locales). OFERTA_RUTA indica el archivo; por ejemplo, la muestra:
# OFERTA_LOCAL=1
# OFERTA_RUTA=datos/ejemplos/carreras.json
